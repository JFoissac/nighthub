# Server Configuration
PORT=3000
NODE_ENV=development

# YouTube OAuth
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Twitch OAuth
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# Twitter/X OAuth
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAPjU9AEAAAAAdTgWjgVGZKj7mASrTyNa5zCLd0U%3DnmhU0IlRIttmmQXIuhZbcHf0WJJecpwOpzlKNdEshriVqOdo5v
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=a74ad14a60941c71f4640e590912d3ac

# YouTube Data API v3 (optional — for duration fetching and better Shorts filtering)
# Get a key at https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_key

# Piped / Invidious fallback (optional — for duration fetching when no YouTube API key)
# Example: https://pipedapi.kavin.rocks
PIPED_INSTANCE_URL=

# Database
DATABASE_URL="file:./dev.db"