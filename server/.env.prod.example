# Production Environment Configuration
# WARNING: REAL CREDENTIALS - DO NOT COMMIT TO VERSION CONTROL
# This file should be provided via secure secret management (Vault, AWS Secrets Manager, etc.)

# Server
NODE_ENV=production
PORT=3000

# CORS - Production whitelist (configure via environment variable CORS_ORIGINS)
# Never use localhost or generic origins in production
CORS_ORIGINS=https://yourproductiondomain.com,https://www.yourproductiondomain.com

# YouTube OAuth
YOUTUBE_CLIENT_ID=${YOUTUBE_CLIENT_ID}
YOUTUBE_CLIENT_SECRET=${YOUTUBE_CLIENT_SECRET}
YOUTUBE_REDIRECT_URI=https://yourdomain.com/api/auth/youtube/callback

# Twitch OAuth
TWITCH_CLIENT_ID=${TWITCH_CLIENT_ID}
TWITCH_CLIENT_SECRET=${TWITCH_CLIENT_SECRET}
TWITCH_REDIRECT_URI=https://yourdomain.com/api/auth/twitch/callback

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=${OPENWEATHERMAP_API_KEY}

# YouTube Data API v3
YOUTUBE_API_KEY=${YOUTUBE_API_KEY}

# Piped / Invidious fallback (optional)
PIPED_INSTANCE_URL=${PIPED_INSTANCE_URL}

# Database - Production should use managed database
DATABASE_URL=${DATABASE_URL}
