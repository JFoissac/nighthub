# Server Configuration
PORT=3000
NODE_ENV=development

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# YouTube OAuth
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Twitch OAuth
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# YouTube Data API v3 (optional)
YOUTUBE_API_KEY=your_youtube_data_api_key

# Piped / Invidious fallback (optional)
PIPED_INSTANCE_URL=https://pipedapi.kavin.rocks

# Database
DATABASE_URL="file:./dev.db"

# ---- Trump Watch v2 ----

# Analyse IA des posts Trump + veille news (provider OpenAI-compatible).
# Sans clé, le scoring de criticité existant est utilisé (fallback automatique).
TRUMP_AI_API_KEY=
# URL de base compatible /chat/completions (défaut : https://api.openai.com/v1)
TRUMP_AI_BASE_URL=https://api.openai.com/v1
TRUMP_AI_MODEL=gpt-4o-mini
# Seuil de pertinence IA : les posts/news en dessous sont filtrés (défaut 1)
TRUMP_AI_MIN_RELEVANCE=1
# Taille des lots envoyés au provider (défaut 20)
TRUMP_AI_BATCH_SIZE=20

# Veille « Trump TV / news / conférences de presse » (RSS médias)
# Surcharge optionnelle des sources : "url|label,url|label"
TRUMP_NEWS_FEEDS=
# Fréquence de rafraîchissement de la veille en minutes (défaut 10)
TRUMP_NEWS_REFRESH_MINUTES=10
