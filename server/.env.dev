# Development Environment Configuration
# WARNING: This file contains non-sensitive defaults for local development only

# Server
NODE_ENV=development
PORT=3000

# CORS - Development allows localhost
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# YouTube OAuth (use test credentials for development)
YOUTUBE_CLIENT_ID=dev_youtube_client_id
YOUTUBE_CLIENT_SECRET=dev_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Twitch OAuth
TWITCH_CLIENT_ID=dev_twitch_client_id
TWITCH_CLIENT_SECRET=dev_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# Twitter/X OAuth
TWITTER_CLIENT_ID=dev_twitter_client_id
TWITTER_CLIENT_SECRET=dev_twitter_client_secret
TWITTER_BEARER_TOKEN=dev_twitter_bearer_token
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback

# OpenWeatherMap (use test/demo key for development)
OPENWEATHERMAP_API_KEY=dev_test_api_key

# YouTube Data API v3 (leave empty for development - uses RSS only)
YOUTUBE_API_KEY=

# Piped / Invidious fallback
PIPED_INSTANCE_URL=https://pipedapi.kavin.rocks

# Database
DATABASE_URL="file:./dev.db"