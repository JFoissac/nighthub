# Test Environment Configuration
# WARNING: This file contains isolated test data, no real credentials

# Server
NODE_ENV=test
PORT=3001

# CORS - Test environment uses different port
CORS_ORIGINS=http://localhost:4201,http://127.0.0.1:4201

# YouTube OAuth (mock credentials for testing)
YOUTUBE_CLIENT_ID=test_youtube_client_id
YOUTUBE_CLIENT_SECRET=test_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback

# Twitch OAuth
TWITCH_CLIENT_ID=test_twitch_client_id
TWITCH_CLIENT_SECRET=test_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:3001/api/auth/twitch/callback

# Twitter/X OAuth
TWITTER_CLIENT_ID=test_twitter_client_id
TWITTER_CLIENT_SECRET=test_twitter_client_secret
TWITTER_BEARER_TOKEN=test_twitter_bearer_token
TWITTER_REDIRECT_URI=http://localhost:3001/api/auth/twitter/callback

# OpenWeatherMap (mock API key for testing)
OPENWEATHERMAP_API_KEY=test_openweathermap_api_key

# YouTube Data API v3 (leave empty for testing - mocked)
YOUTUBE_API_KEY=

# Piped / Invidious fallback (empty for testing)
PIPED_INSTANCE_URL=

# Database - Use separate test database
DATABASE_URL="file:./test.db"